function attachFromComposer(files, how) {
  if (!files.length) return false;
  if ($('attachment-controls').disabled || attachmentPanel.isBusy()) {
    toast.show({ kind: 'warn', key: 'paste-attach', title: `지금은 ${how} 파일을 첨부할 수 없습니다`,
      detail: 'AI가 대답하는 중이거나 첨부를 올리는 중입니다. 끝난 뒤(또는 「중지」를 누른 뒤) 다시 해 주세요.' });
    return true;
  }
  void attachmentPanel.addFiles(files);
  return true;
}
