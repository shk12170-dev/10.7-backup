$('file-open-browser')?.addEventListener('click', async () => {
  if (busy || sendInFlight || reconnectInProgress) return;
  const path = $('file-open-browser').dataset.path;
  const openStatus = $('file-open-status');
  if (typeof path !== 'string' || !/\.html?$/i.test(path)) {
    if (openStatus) openStatus.textContent = 'HTML 파일을 선택하세요.';
    return;
  }
  // Open the tab during the user's click. Awaiting the server first can lose
  // browser activation, and window.open(..., 'noopener') returns null even on
  // successful opens in Chrome, so that return value cannot report success.
  const opened = window.open('about:blank', '_blank');
  if (!opened) {
    if (openStatus) openStatus.textContent = '팝업이 막혔습니다. 브라우저에서 팝업을 허용해 주세요.';
    status('브라우저 팝업이 차단되었습니다.');
    return;
  }
  try {
    opened.opener = null;
    $('file-open-browser').disabled = true;
    if (openStatus) openStatus.textContent = '브라우저에서 여는 중…';
    const result = await request('/api/preview/open', { path });
    let target;
    try { target = new URL(result?.url); } catch { /* handled below */ }
    if (!target || target.protocol !== 'http:' || target.hostname !== '127.0.0.1' || !target.port || target.username || target.password) {
      throw new Error('WB_GUI_PREVIEW_OPEN_FAILED');
    }
    // Local UI only: absolute stays on screen; do not post paths to chat/channel.
    if (result.absolute) paintFilePathMeta({ absolute: result.absolute, relative: result.relative || path });
    if (opened.closed) throw new Error('WB_GUI_PREVIEW_OPEN_FAILED');
    opened.location.replace(target.href);
    if (openStatus) openStatus.textContent = '브라우저 탭을 열었습니다. 정적 미리보기와 다릅니다.';
    status('사용자용 브라우저 탭에서 프로젝트 HTML을 열었습니다.');
  } catch (error) {
    try { opened.close(); } catch {}
    if (openStatus) openStatus.textContent = '열지 못했습니다.';
    status(friendlyError(error));
  } finally {
    const rel = $('file-open-browser').dataset.path;
    $('file-open-browser').disabled = !rel || busy || sendInFlight || reconnectInProgress;
  }
});

