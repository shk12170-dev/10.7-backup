import { friendlyError } from './error-messages.js';
export function bindEnrollmentPanel({ container, request }) {
  const root = document.createElement('section');
  root.className = 'enrollment-panel';
  root.innerHTML = [
    '<h2>기기 연결</h2>',
    '<p class="enrollment-status" data-status></p>',
    '<p class="enrollment-guide" data-guide></p>',
    '<p class="enrollment-confirm" data-confirm hidden></p>',
    '<p class="enrollment-url" data-url hidden></p>',
    '<p class="enrollment-error" data-error hidden></p>',
    '<div class="enrollment-actions">',
    '<button type="button" data-local hidden>로컬 모드로 돌아가기</button>',
    '<button type="button" data-start>기기 연결 시작</button>',
    '<button type="button" data-cancel disabled>취소</button>',
    '<button type="button" data-reconnect>다시 연결</button>',
    '</div>',
    '<p class="enrollment-hint">승인 URL과 확인번호만 표시합니다. 키나 토큰을 입력하지 마세요.</p>',
  ].join('');
  container.replaceChildren(root);
  const statusEl = root.querySelector('[data-status]');
  const guideEl = root.querySelector('[data-guide]');
  const confirmEl = root.querySelector('[data-confirm]');
  const urlEl = root.querySelector('[data-url]');
  const errorEl = root.querySelector('[data-error]');
  const startBtn = root.querySelector('[data-start]');
  const localBtn = root.querySelector('[data-local]');
  const cancelBtn = root.querySelector('[data-cancel]');
  const reconnectBtn = root.querySelector('[data-reconnect]');
  let disposed = false;
  let pollTimer = null;
  let appliedGeneration = -1;

  function paint(snap) {
    if (disposed || !snap) return;
    if (typeof snap.generation === 'number') {
      if (snap.generation < appliedGeneration) return;
      appliedGeneration = snap.generation;
    }
    statusEl.textContent = '상태: ' + (snap.status || 'idle');
    const awaiting = snap.status === 'awaitingApproval';
    const keepPolling = !!snap.busy || snap.status === 'awaitingApproval' || snap.status === 'saving';
    guideEl.textContent = awaiting
      ? '브라우저에서 아래 승인 페이지를 열고 확인번호가 같은지 확인한 뒤 승인하세요.'
      : snap.status === 'ready'
        ? '기기 연결이 완료되었습니다. 모델 경로에서 CLCO 연결을 확인하세요.'
        : snap.status === 'notEligible'
          ? '클라우드 이용 조건을 충족하면 다시 연결할 수 있습니다. 지금은 모델 경로에서 로컬 모드를 선택해 작업하세요.'
          : snap.status === 'accountInactive'
            ? 'ALEPH 계정 상태를 확인해 주세요. 로컬 모드에서는 계속 작업할 수 있습니다.'
        : snap.status === 'cancelled'
          ? '기기 연결 절차가 취소되었습니다. 현재 모델 연결 상태는 모델 경로에서 확인해 주세요.'
          : snap.hadCredentialBefore
            ? '이 PC에 저장된 연결 정보가 있습니다. 현재 연결 상태는 모델 경로에서 확인해 주세요.'
            : '기기 연결을 시작하면 승인 URL과 확인번호가 표시됩니다.';
    if (awaiting && snap.confirmation) {
      confirmEl.hidden = false;
      confirmEl.textContent = '확인번호: ' + snap.confirmation;
    } else {
      confirmEl.hidden = true;
      confirmEl.textContent = '';
    }
    if (awaiting && snap.approvalUrl) {
      urlEl.hidden = false;
      urlEl.textContent = '승인 URL: ' + snap.approvalUrl;
    } else {
      urlEl.hidden = true;
      urlEl.textContent = '';
    }
    if (snap.lastError) {
      errorEl.hidden = false;
      errorEl.textContent = friendlyError(snap.lastError);
    } else {
      errorEl.hidden = true;
      errorEl.textContent = '';
    }
    startBtn.disabled = !!snap.busy;
    const localFirst = ['notEligible', 'accountInactive'].includes(snap.status);
    localBtn.hidden = !localFirst || typeof request.useLocal !== 'function';
    localBtn.disabled = !!snap.busy;
    startBtn.textContent = localFirst ? '다시 승인받기' : '기기 연결 시작';
    root.className = localFirst ? 'enrollment-panel enrollment-local-first' : 'enrollment-panel';
    reconnectBtn.disabled = !!snap.busy;
    cancelBtn.disabled = !snap.busy;
    if (keepPolling && !pollTimer) {
      pollTimer = setInterval(() => { run(() => request.state()); }, 1500);
    }
    if (!keepPolling && pollTimer) {
      clearInterval(pollTimer);
      pollTimer = null;
    }
  }

  async function run(action) {
    try { paint(await action()); }
    catch (error) {
      errorEl.hidden = false;
      errorEl.textContent = friendlyError(error);
      try { paint(await request.state()); } catch { /* keep */ }
    }
  }

  startBtn.addEventListener('click', () => run(() => request.start()));
  localBtn.addEventListener('click', () => run(() => request.useLocal()));
  reconnectBtn.addEventListener('click', () => run(() => request.start()));
  cancelBtn.addEventListener('click', () => run(() => request.cancel()));

  return {
    refresh: () => run(() => request.state()),
    dispose() {
      disposed = true;
      if (pollTimer) clearInterval(pollTimer);
      root.remove();
    },
  };
}
